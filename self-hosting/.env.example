# Metorial Self-Hosting Environment Configuration
# Copy to .env and customize for your deployment

# =============================================================================
# REQUIRED
# =============================================================================

# Secret key for encryption and authentication (min 32 characters)
# Generate with: openssl rand -hex 32
SECRET=your-secret-key-min-32-chars

# Host URL (without port)
HOST=http://localhost

# =============================================================================
# IMAGE CONFIGURATION (Optional)
# =============================================================================
# By default, uses locally built images (metorial-api:local, metorial-engine:local)
# Build with: mise run selfhost:build-all
#
# To use remote images instead, uncomment:
# METORIAL_API_IMAGE=ghcr.io/jrmatherly/metorial-api:dev
# METORIAL_ENGINE_IMAGE=ghcr.io/jrmatherly/metorial-mcp-engine-unified:dev

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP Configuration
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=true
# EMAIL_USER=your-email@example.com
# EMAIL_PASS=your-email-password
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=Metorial

# =============================================================================
# MEILISEARCH CONFIGURATION (Optional)
# =============================================================================
# API key for Meilisearch authentication (min 16 bytes)
# Generate with: openssl rand -base64 24
# MEILISEARCH_API_KEY=your-secure-api-key

# =============================================================================
# S3/MINIO CONFIGURATION (Optional)
# =============================================================================
# MinIO is included by default for object storage
# These defaults work with the included MinIO service
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio123
# S3_REGION=us-east-1
# S3_BUCKET=metorial

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# GitHub SCM Integration
# SCM_GITHUB_CLIENT_ID=your-github-client-id
# SCM_GITHUB_CLIENT_SECRET=your-github-client-secret

# Deno Deploy Integration
# DENO_DEPLOY_TOKEN=your-deno-token
# DENO_ORGANIZATION_ID=your-org-id
